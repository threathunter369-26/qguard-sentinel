# ==========================================================================
# QGuard Sentinel — environment configuration
# Copy to `.env` and fill in. NEVER commit a populated .env file.
# ==========================================================================

# -------------------------------- Runtime ---------------------------------
QG_ENV=development                      # development | staging | production
QG_DEBUG=true
QG_LOG_LEVEL=INFO
QG_LOG_FORMAT=console                   # console | json  (use json in prod)
QG_INSTANCE_NAME=qguard-local

# -------------------------------- Database --------------------------------
# Primary PostgreSQL connection (async driver is added automatically).
QG_DATABASE_URL=postgresql://qguard:qguard@localhost:5432/qguard
QG_DATABASE_POOL_SIZE=10
QG_DATABASE_MAX_OVERFLOW=20
QG_DATABASE_ECHO=false
# Optional dedicated read-replica DSN for analytics queries.
QG_DATABASE_REPLICA_URL=

# -------------------------------- Supabase --------------------------------
# Auth provider: supabase | local
# `local` runs fully self-hosted auth (argon2 + TOTP) against PostgreSQL.
QG_AUTH_PROVIDER=local
QG_SUPABASE_URL=
QG_SUPABASE_ANON_KEY=
QG_SUPABASE_SERVICE_ROLE_KEY=
# JWT verification material. Supabase legacy projects use the HS256 secret;
# newer projects publish asymmetric keys at /auth/v1/.well-known/jwks.json
QG_SUPABASE_JWT_SECRET=
QG_SUPABASE_JWKS_URL=
QG_SUPABASE_JWT_AUDIENCE=authenticated
QG_SUPABASE_STORAGE_BUCKET=qguard-evidence

# ------------------------- Local auth / tokens -----------------------------
# 64 hex chars. Generate with: openssl rand -hex 32
QG_JWT_SECRET=change-me-openssl-rand-hex-32
QG_JWT_ALGORITHM=HS256
QG_ACCESS_TOKEN_TTL_SECONDS=900
QG_REFRESH_TOKEN_TTL_SECONDS=1209600
QG_PASSWORD_MIN_LENGTH=12
QG_MAX_FAILED_LOGINS=5
QG_LOCKOUT_SECONDS=900
QG_MFA_ISSUER=QGuard Sentinel

# Application data-encryption key (evidence metadata, MFA seeds, feed creds).
# Generate with: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
QG_ENCRYPTION_KEY=

# -------------------------------- HTTP / API -------------------------------
QG_API_HOST=0.0.0.0
QG_API_PORT=8000
QG_API_ROOT_PATH=
QG_PUBLIC_API_URL=http://localhost:8000
QG_CORS_ORIGINS=http://localhost:3000
QG_TRUSTED_HOSTS=localhost,127.0.0.1
QG_SECURE_COOKIES=false                 # must be true behind TLS
QG_COOKIE_DOMAIN=
QG_RATE_LIMIT_ENABLED=true
QG_RATE_LIMIT_DEFAULT=300/minute
QG_RATE_LIMIT_AUTH=10/minute
QG_MAX_UPLOAD_BYTES=2147483648          # 2 GiB (mobile packages, disk images)
QG_REQUEST_TIMEOUT_SECONDS=60

# -------------------------------- Storage ----------------------------------
# local | supabase | s3
QG_STORAGE_BACKEND=local
QG_STORAGE_LOCAL_ROOT=./var/storage
QG_S3_ENDPOINT_URL=
QG_S3_BUCKET=
QG_S3_REGION=
QG_S3_ACCESS_KEY_ID=
QG_S3_SECRET_ACCESS_KEY=

# -------------------------------- Workers ----------------------------------
QG_WORKER_CONCURRENCY=4
QG_WORKER_POLL_INTERVAL_SECONDS=2
QG_WORKER_HEARTBEAT_SECONDS=15
QG_JOB_MAX_ATTEMPTS=3
QG_JOB_LEASE_SECONDS=900
QG_JOB_RETENTION_DAYS=90
# Sandbox for untrusted artifact analysis: subprocess | docker | none
# `none` is refused outside development.
QG_SANDBOX_MODE=subprocess
QG_SANDBOX_CPU_SECONDS=120
QG_SANDBOX_MEMORY_MB=2048
QG_SANDBOX_MAX_OUTPUT_BYTES=16777216
QG_SANDBOX_DOCKER_IMAGE=qguard/sandbox:latest

# --------------------------- Scanning safety rails -------------------------
# Active scanning is refused unless an approved TestAuthorization covers the
# target. These are additional hard global guardrails.
QG_ACTIVE_SCAN_ENABLED=true
QG_ALLOW_PRIVATE_NETWORK_TARGETS=true   # set false for SaaS deployments
QG_SCAN_DENY_NETWORKS=169.254.0.0/16,::1/128,fc00::/7
QG_SCAN_MAX_REQUESTS_PER_SECOND=10
QG_SCAN_MAX_CONCURRENCY=8
QG_SCAN_USER_AGENT=QGuardSentinel/1.0 (authorized security assessment)
QG_SCAN_HTTP_TIMEOUT_SECONDS=15
QG_SCAN_MAX_CRAWL_PAGES=250

# ------------------------- Vulnerability intelligence ----------------------
# OSV.dev is used for SCA. Offline deployments fall back to the local cache
# and mark affected engine runs as DEGRADED rather than reporting clean.
QG_OSV_API_URL=https://api.osv.dev/v1
QG_OSV_ENABLED=true
QG_NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
QG_NVD_API_KEY=
QG_CVE_CACHE_TTL_HOURS=24
QG_EPSS_API_URL=https://api.first.org/data/v1/epss
QG_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
QG_THREAT_INTEL_OUTBOUND_ENABLED=false

# -------------------------------- Frontend ---------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=QGuard Sentinel
NEXT_PUBLIC_AUTH_PROVIDER=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------- Observability -----------------------------
QG_METRICS_ENABLED=true
QG_OTEL_EXPORTER_OTLP_ENDPOINT=
QG_SENTRY_DSN=

# ------------------------------- Dev seed data -----------------------------
# Seeds a clearly-labelled DEMO organization. Refused when QG_ENV=production.
QG_SEED_DEMO_DATA=false
QG_SEED_ADMIN_EMAIL=admin@qguard.local
QG_SEED_ADMIN_PASSWORD=
